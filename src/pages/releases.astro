---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteShell from "../components/SiteShell.astro";
import { getSiteContent } from "../lib/siteContent";
import { getReleasePostViews } from "../lib/postViews";

const content = await getSiteContent();
const releaseCards = getReleasePostViews(content);
---

<BaseLayout title="15 love — Releases">
  <SiteShell activeTab="releases">
    <div slot="left" class="colblock colblock-left releases-left">
      <section class="block block-releases-list">
        <div class="blockhead">
          <h2 class="coltitle">releases</h2>
        </div>
        <ul class="list">
          {releaseCards.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class="text release-list-link" href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="releases-wide">
      <section class="releases-rail-box" aria-label="Releases horizontal feed">
        <div class="releases-rail-scroll">
          <div class="releases-rail">
            {releaseCards.map((card) => (
              <article class="release-card" id={card.id}>
                <a class="release-post release-card-link" href={card.href} data-astro-prefetch="hover">
                  {card.image?.src ? (
                    <img
                      class="release-image"
                      src={card.image.src}
                      alt={card.image.alt}
                      width="340"
                      height="340"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                  {card.title ? <h3 class="release-title">{card.title}</h3> : null}
                  <div class="release-credits" aria-label="Release credits">
                    {card.credits.map((c) => (
                      <div class="credit-line">
                        <span class="credit-label">{c.label}</span> <span class="credit-value">{c.value}</span>
                      </div>
                    ))}
                  </div>
                  {card.body ? <p class="release-body">{card.body}</p> : null}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </div>
  </SiteShell>
</BaseLayout>

<style>
  .releases-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .releases-left .block-releases-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .releases-wide {
    height: 100%;
  }

  .releases-rail-box {
    border: 1px solid #000;
    height: 100%;
    background: #fff;
  }

  .releases-rail-scroll {
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .releases-rail {
    min-height: 100%;
    width: max-content;
    display: flex;
  }

  .release-card {
    width: 840px;
    min-height: 100%;
    border-right: 1px solid #000;
    padding: 12px;
    display: block;
  }

  .release-post {
    display: block;
    overflow: hidden;
  }

  .release-post::after {
    content: "";
    display: block;
    clear: both;
  }

  .release-card-link,
  .release-list-link {
    color: inherit;
    text-decoration: none;
  }

  .release-card-link:hover .release-title,
  .release-list-link:hover {
    text-decoration: underline;
  }

  .release-image {
    float: left;
    width: 340px;
    height: 340px;
    margin: 0 14px 10px 0;
    object-fit: cover;
    border: 1px solid #000;
    display: block;
  }

  .release-title {
    margin: 0 0 12px;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 400;
  }

  .release-credits {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 14px;
    font-size: 16px;
    line-height: 1.2;
  }

  .credit-line {
    margin: 0;
  }

  .credit-label {
    font-family: "TT2020 Style B", "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: 0.02em;
  }

  .credit-value {
    font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: normal;
  }

  .release-body {
    margin: 0;
    font-size: 15.4px;
    line-height: 1.25;
  }
</style>
