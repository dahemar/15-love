---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import MobileShell from "../../components/MobileShell.astro";
import MobileEventDetail from "../../components/mobile/MobileEventDetail.astro";
import { renderRichBody } from "../../lib/html";
import { getSiteContent } from "../../lib/siteContent";
import { newsImageDimensions } from "../../lib/newsImageWidth";
import { getEventPostViews, getEventStaticPathParams } from "../../lib/postViews";

export async function getStaticPaths() {
  const content = await getSiteContent();
  return getEventStaticPathParams(content).map(({ id }) => ({ params: { id } }));
}

function formatDateLabel(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(date);
}

const content = await getSiteContent();
const posts = getEventPostViews(content);
const post = posts.find((entry) => entry.id === Astro.params.id || entry.legacyId === Astro.params.id);
const backHref = "/events/";

if (!post) {
  throw new Error(`Unknown event post: ${Astro.params.id}`);
}

const headerDate = post.dateLabel || formatDateLabel(post.publishedAt);
---

<BaseLayout title={`15 love — ${post.title}`}>
  <div class="layout-desktop">
  <SiteShell activeTab="events">
    <div slot="left" class="colblock colblock-left events-left">
      <section class="block block-events-list">
        <div class="blockhead">
          <h2 class="coltitle">events</h2>
        </div>
        <ul class="list">
          {posts.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class={`text event-list-link${item.id === post.id ? " is-active" : ""}`} href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="events-detail-wide">
      <section class="events-detail-box" aria-label="Event detail">
        <a
          class="detail-back"
          href={backHref}
          aria-label="Back to events"
          onclick={`if (window.history.length > 1) { window.history.back(); return false; }`}
        >
          <span aria-hidden="true">←</span>
        </a>
        <article class="events-entry">
          <header class="events-entry-header">
            <h1 class="events-entry-title">{post.title}</h1>
            {headerDate ? <p class="events-entry-date">{headerDate}</p> : null}
            {post.venue ? <p class="events-entry-venue">{post.venue}</p> : null}
          </header>

          {post.eventBlocks.map((block, index) => {
            if (block.__component === "events.details") return null;

            if (block.__component === "events.rich-text") {
              return <div class="events-block events-richtext" set:html={renderRichBody(block.body)} />;
            }

            if (block.__component !== "events.media" || !block.image) return null;
            const size = block.imageWidth ?? "medium";
            const fallback = newsImageDimensions(size);
            const width = block.image.width ?? fallback.width;
            const height = block.image.height ?? fallback.height;

            return (
              <figure class={`events-block events-media is-${block.imagePosition} is-${size}`}>
                <img
                  class="events-image"
                  src={block.image.url}
                  alt={block.image.alt}
                  width={width}
                  height={height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                />
                {block.caption ? <figcaption class="events-caption">{block.caption}</figcaption> : null}
              </figure>
            );
          })}

          {post.tags && post.tags.length ? (
            <footer class="post-tags">
              <div class="tagsText tagsLinks">
                {post.tags.map((tag, tagIndex) => (
                  <>
                    <a class="tagLink" href={`/archive?tag=${encodeURIComponent(tag)}`} data-astro-prefetch="hover">{tag}</a>
                    {tagIndex < post.tags.length - 1 ? <span>, </span> : null}
                  </>
                ))}
              </div>
            </footer>
          ) : null}
        </article>
      </section>
    </div>
  </SiteShell>
  </div>

  <div class="layout-mobile">
    <MobileShell activeTab="events">
      <MobileEventDetail post={post} />
    </MobileShell>
  </div>
</BaseLayout>

<style>
  .events-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .events-left .block-events-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .events-detail-wide {
    height: 100%;
  }

  .events-detail-box {
    position: relative;
    border: 1px solid #000;
    border-top: none;
    height: 100%;
    background: #fff;
    overflow-y: auto;
  }

  .detail-back {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 22px;
    line-height: 1;
  }

  .detail-back:hover {
    background: #fff;
  }

  .events-entry {
    min-height: 100%;
    padding: 16px 22px 18px;
    background: #fff;
    box-sizing: border-box;
  }

  .events-entry::after {
    content: "";
    display: block;
    clear: both;
  }

  .events-entry-header {
    width: min(100%, 780px);
    max-width: none;
    padding-right: 56px;
    margin-bottom: 28px;
  }

  .events-entry-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.1;
    font-weight: 400;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .events-entry-date {
    margin: 8px 0 24px;
    font-size: 14px;
    line-height: 1;
  }

  .events-entry-venue {
    margin: 6px 0 8px;
    font-size: 16px;
    line-height: 1.2;
    font-family: "TT2020 Style B", "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }

  .events-block {
    min-width: 0;
    margin-bottom: 14px;
  }

  .events-richtext {
    max-width: none;
    font-size: 16px;
    line-height: 1.36;
  }

  .events-richtext :global(p) {
    margin: 0 0 0.85em;
  }

  .events-richtext :global(p:last-child) {
    margin-bottom: 0;
  }

  .events-media {
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .events-media.is-left {
    float: left;
    margin: 0 20px 14px 0;
  }

  .events-media.is-right {
    float: right;
    margin: 0 0 14px 20px;
  }

  .events-media.is-center {
    clear: both;
    margin: 0 auto 14px;
  }

  .events-media.is-full {
    clear: both;
    width: 100%;
    max-width: 636px;
  }

  .events-media.is-xs {
    width: 140px;
  }

  .events-media.is-narrow {
    width: 220px;
  }

  .events-media.is-medium {
    width: 320px;
  }

  .events-media.is-wide {
    width: 460px;
  }

  .events-media.is-xl {
    width: 540px;
  }

  .events-media.is-max {
    width: 636px;
  }

  .events-image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #000;
    object-fit: cover;
  }

  .events-caption {
    max-width: 32ch;
    font-size: 12px;
    line-height: 1.25;
  }

  .event-list-link {
    color: inherit;
    text-decoration: none;
  }

  .event-list-link:hover,
  .event-list-link.is-active {
    text-decoration: underline;
  }

  .post-tags {
    clear: both;
    margin-top: 18px;
  }

  .post-tags .tagsText {
    display: inline-block;
    margin-top: 0;
    padding: 8px 10px;
    border: 1px solid #000;
    background: #fff;
  }

  .tagsLinks {
    display: block;
  }

  .tagLink {
    color: #000;
    text-decoration: none;
  }

  .tagLink:hover {
    text-decoration: underline;
  }
</style>
