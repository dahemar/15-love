---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import MobileShell from "../../components/MobileShell.astro";
import MobileEventDetail from "../../components/mobile/MobileEventDetail.astro";
import { renderRichBody } from "../../lib/html";
import { getSiteContent } from "../../lib/siteContent";
import { newsImageDimensions } from "../../lib/newsImageWidth";
import { getEventPostViews, getEventStaticPathParams } from "../../lib/postViews";
import "../../styles/events-detail.css";

export async function getStaticPaths() {
  const content = await getSiteContent();
  return getEventStaticPathParams(content).map(({ id }) => ({ params: { id } }));
}

function formatDateLabel(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(date);
}

const content = await getSiteContent();
const posts = getEventPostViews(content);
const post = posts.find((entry) => entry.id === Astro.params.id || entry.legacyId === Astro.params.id);
const backHref = "/events/";

if (!post) {
  throw new Error(`Unknown event post: ${Astro.params.id}`);
}

const headerDate = post.dateLabel || formatDateLabel(post.publishedAt);
---

<BaseLayout title={`15 love — ${post.title}`}>
  <div class="layout-desktop">
  <SiteShell activeTab="events">
    <div slot="left" class="colblock colblock-left events-left">
      <section class="block block-events-list">
        <div class="blockhead">
          <h2 class="coltitle">events</h2>
        </div>
        <ul class="list">
          {posts.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class={`text event-list-link${item.id === post.id ? " is-active" : ""}`} href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="events-wide">
      <section class="events-detail-box" aria-label="Event detail">
        <a
          class="detail-back"
          href={backHref}
          aria-label="Back to events"
          onclick={`if (window.history.length > 1) { window.history.back(); return false; }`}
        >
          <span aria-hidden="true">←</span>
        </a>
        <article class="event-entry">
          <header class="event-entry-header">
            {headerDate ? <p class="event-date">{headerDate}</p> : null}
            <h1 class="event-entry-title">{post.title}</h1>
            {post.venue ? <p class="event-subline">{post.venue}</p> : null}
          </header>

          {post.eventBlocks.map((block, index) => {
            if (block.__component === "events.details") return null;

            if (block.__component === "events.rich-text") {
              return <div class="event-block event-richtext" set:html={renderRichBody(block.body)} />;
            }

            if (block.__component !== "events.media" || !block.image) return null;
            const size = block.imageWidth ?? "medium";
            const fallback = newsImageDimensions(size);

            return (
              <figure class={`event-block event-media is-${block.imagePosition} is-${size}`}>
                <img
                  class="event-image"
                  src={block.image.url}
                  alt={block.image.alt}
                  width={block.image.width ?? fallback.width}
                  height={block.image.height ?? fallback.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                />
                {block.caption ? <figcaption class="event-caption">{block.caption}</figcaption> : null}
              </figure>
            );
          })}

          {post.tags && post.tags.length ? (
            <footer class="post-tags">
              <div class="tagsText tagsLinks">
                {post.tags.map((tag, tagIndex) => (
                  <>
                    <a class="tagLink" href={`/archive?tag=${encodeURIComponent(tag)}`} data-astro-prefetch="hover">{tag}</a>
                    {tagIndex < post.tags.length - 1 ? <span>, </span> : null}
                  </>
                ))}
              </div>
            </footer>
          ) : null}
        </article>
      </section>
    </div>
  </SiteShell>
  </div>

  <div class="layout-mobile">
    <MobileShell activeTab="events">
      <MobileEventDetail post={post} />
    </MobileShell>
  </div>
</BaseLayout>

<style>
  .events-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .events-left .block-events-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .events-wide {
    height: 100%;
  }

  .events-detail-box {
    position: relative;
    border: 1px solid #000;
    height: 100%;
    background: #fff;
    overflow-y: auto;
  }

  .detail-back {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 22px;
    line-height: 1;
  }

  .detail-back:hover {
    background: #fff;
  }

  .event-list-link {
    color: inherit;
    text-decoration: none;
  }

  .event-list-link:hover,
  .event-list-link.is-active {
    text-decoration: underline;
  }
</style>
