---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteShell from "../components/SiteShell.astro";
import MobileShell from "../components/MobileShell.astro";
import MobileEventsList from "../components/mobile/MobileEventsList.astro";
import { getSiteContent } from "../lib/siteContent";
import { getEventPostViews } from "../lib/postViews";

const content = await getSiteContent();
const cards = getEventPostViews(content);
---

<BaseLayout title="15 love — Events">
  <div class="layout-desktop">
  <SiteShell activeTab="events">
    <div slot="left" class="colblock colblock-left events-left">
      <section class="block block-events-list">
        <div class="blockhead">
          <h2 class="coltitle">events</h2>
        </div>
        <ul class="list">
          {cards.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class="text event-list-link" href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="events-wide">
      <section class="events-rail-box" aria-label="Events horizontal feed">
        <div class="events-rail-scroll">
          <div class="events-rail">
            {cards.map((card) => (
              <article class="event-card" id={card.id}>
                <a class="event-post event-card-link" href={card.href} data-astro-prefetch="hover">
                  {card.image ? (
                    <img
                      class="event-image"
                      src={card.image.url}
                      alt={card.image.alt}
                      width="520"
                      height="340"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="event-image event-image-empty" aria-hidden="true"></div>
                  )}

                  <div class="event-meta">
                    <h3 class="event-title">{card.title}</h3>
                    {card.venue || card.dateLabel ? (
                      <p class="event-subline">{[card.venue, card.dateLabel].filter(Boolean).join(" — ")}</p>
                    ) : null}
                    {card.body ? <p class="event-body">{card.body}</p> : null}
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </div>
  </SiteShell>
  </div>

  <div class="layout-mobile">
    <MobileShell activeTab="events">
      <MobileEventsList />
    </MobileShell>
  </div>
</BaseLayout>

<style>
  .events-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .events-left .block-events-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .events-wide {
    height: 100%;
  }

  .events-rail-box {
    border: 1px solid #000;
    height: 100%;
    background: #fff;
  }

  .events-rail-scroll {
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .events-rail {
    min-height: 100%;
    width: max-content;
    display: flex;
  }

  .event-card {
    width: 860px;
    min-height: 100%;
    border-right: 1px solid #000;
    padding: 12px;
    display: block;
  }

  .event-post {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .event-card-link,
  .event-list-link {
    color: inherit;
    text-decoration: none;
  }

  .event-card-link:hover .event-title,
  .event-list-link:hover {
    text-decoration: underline;
  }

  .event-image {
    width: 520px;
    max-width: 100%;
    height: 340px;
    object-fit: cover;
    border: 1px solid #000;
    display: block;
  }

  .event-image-empty {
    border: 1px solid #000;
    background: transparent;
  }

  .event-meta {
    max-width: 520px;
  }

  .event-title {
    margin: 0 0 10px;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 400;
  }

  .event-subline {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.2;
    font-family: "TT2020 Style B", "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }

  .event-body {
    margin: 0;
    font-size: 15.4px;
    line-height: 1.25;
    white-space: pre-line;
  }
</style>
