---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import MobileShell from "../../components/MobileShell.astro";
import MobileReleaseDetail from "../../components/mobile/MobileReleaseDetail.astro";
import { getSiteContent } from "../../lib/siteContent";
import { getReleasePostViews } from "../../lib/postViews";
import { releaseParagraphInnerHtml, splitReleaseBodyParagraphs } from "../../lib/releaseBody";
import "../../styles/releases-detail.css";

export async function getStaticPaths() {
  const content = await getSiteContent();
  return getReleasePostViews(content).flatMap((post) => {
    const paths = [{ params: { id: post.id } }];
    if (post.legacyId && post.legacyId !== post.id) {
      paths.push({ params: { id: post.legacyId } });
    }
    return paths;
  });
}

const content = await getSiteContent();
const posts = getReleasePostViews(content);
const post = posts.find((entry) => entry.id === Astro.params.id || entry.legacyId === Astro.params.id);
const backHref = "/releases/";
const bodyParagraphs = post?.body ? splitReleaseBodyParagraphs(post.body) : [];

if (!post) {
  throw new Error(`Unknown release post: ${Astro.params.id}`);
}
---

<BaseLayout title={`15 love — ${post.title}`}>
  <div class="layout-desktop">
  <SiteShell activeTab="releases">
    <div slot="left" class="colblock colblock-left releases-left">
      <section class="block block-releases-list">
        <div class="blockhead">
          <h2 class="coltitle">releases</h2>
        </div>
        <ul class="list">
          {posts.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class={`text release-list-link${item.id === post.id ? " is-active" : ""}`} href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="releases-wide">
      <section class="releases-detail-box" aria-label="Release detail">
        <a
          class="detail-back"
          href={backHref}
          aria-label="Back to releases"
          onclick={`if (window.history.length > 1) { window.history.back(); return false; }`}
        >
          <span aria-hidden="true">←</span>
        </a>
        <article class="release-detail">
          {post.image?.src ? (
            <img
              class="release-image"
              src={post.image.src}
              alt={post.image.alt}
              width="420"
              height="520"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ) : null}
          <h1 class="sr-only">{post.title}</h1>
          {post.credits.map((credit) => (
            <p class="credit-line">
              <span class="credit-label">{credit.label}</span>{" "}
              <span class="credit-value">{credit.value}</span>
            </p>
          ))}
          {bodyParagraphs.map((block) => (
            <p class="release-para" set:html={releaseParagraphInnerHtml(block)} />
          ))}
          {post.links.length ? (
            <nav class="release-links" aria-label="Release links">
              {post.links.map((link, index) => (
                <>
                  <a class="release-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  {index < post.links.length - 1 ? <span class="release-link-sep">, </span> : null}
                </>
              ))}
            </nav>
          ) : null}
          {post.tags && post.tags.length ? (
            <footer class="post-tags">
              <div class="tagsText tagsLinks">
                {post.tags.map((tag, index) => (
                  <>
                    <a class="tagLink" href={`/archive?tag=${encodeURIComponent(tag)}`} data-astro-prefetch="hover">{tag}</a>
                    {index < post.tags.length - 1 ? <span>, </span> : null}
                  </>
                ))}
              </div>
            </footer>
          ) : null}
        </article>
      </section>
    </div>
  </SiteShell>
  </div>

  <div class="layout-mobile">
    <MobileShell activeTab="releases">
      <MobileReleaseDetail post={post} />
    </MobileShell>
  </div>
</BaseLayout>

<style>
  .releases-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .releases-left .block-releases-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .releases-wide {
    height: 100%;
  }

  .releases-detail-box {
    position: relative;
    border: 1px solid #000;
    height: 100%;
    background: #fff;
  }

  .detail-back {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 22px;
    line-height: 1;
  }

  .detail-back:hover {
    background: #fff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .release-list-link {
    color: inherit;
    text-decoration: none;
  }

  .release-list-link:hover,
  .release-list-link.is-active {
    text-decoration: underline;
  }
</style>
