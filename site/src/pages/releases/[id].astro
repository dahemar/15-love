---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import { getLocalThumbSrc } from "../../lib/localAssetThumbs";
import { getSiteContent } from "../../lib/siteContent";
import { getReleasePostViews } from "../../lib/postViews";

export async function getStaticPaths() {
  const content = await getSiteContent();
  return getReleasePostViews(content).flatMap((post) => {
    const paths = [{ params: { id: post.id } }];
    if (post.legacyId && post.legacyId !== post.id) {
      paths.push({ params: { id: post.legacyId } });
    }
    return paths;
  });
}

const content = await getSiteContent();
const posts = getReleasePostViews(content);
const post = posts.find((entry) => entry.id === Astro.params.id || entry.legacyId === Astro.params.id);
const backHref = "/releases/";

if (!post) {
  throw new Error(`Unknown release post: ${Astro.params.id}`);
}
---

<BaseLayout title={`15 love — ${post.title}`}>
  <SiteShell activeTab="releases">
    <div slot="left" class="colblock colblock-left releases-left">
      <section class="block block-releases-list">
        <div class="blockhead">
          <h2 class="coltitle">releases</h2>
        </div>
        <ul class="list">
          {posts.map((item) => (
            <li class="li">
              <span class="heart">♡</span>
              <a class={`text release-list-link${item.id === post.id ? " is-active" : ""}`} href={item.href} data-astro-prefetch="hover">{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div slot="center" class="releases-wide">
      <section class="releases-detail-box" aria-label="Release detail">
        <a
          class="detail-back"
          href={backHref}
          aria-label="Back to releases"
          onclick={`if (window.history.length > 1) { window.history.back(); return false; }`}
        >
          <span aria-hidden="true">←</span>
        </a>
        <article class="release-detail">
          {post.image ? (
            <img
              class="release-image"
              src={getLocalThumbSrc(post.image.src)}
              alt={post.image.alt}
              width="420"
              height="420"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <div class="release-image release-image-empty" aria-hidden="true"></div>
          )}
          <div class="release-meta">
            <p class="release-date">{post.dateLabel}</p>
            <h1 class="release-title">{post.title}</h1>
            <div class="release-credits" aria-label="Release credits">
              {post.credits.map((credit) => (
                <div class="credit-line">
                  <span class="credit-label">{credit.label}</span> <span class="credit-value">{credit.value}</span>
                </div>
              ))}
            </div>
            {post.body ? <p class="release-body">{post.body}</p> : null}
          </div>
          {post.tags && post.tags.length ? (
            <footer class="post-tags">
              <div class="tagsText tagsLinks">
                {post.tags.map((tag, index) => (
                  <>
                    <a class="tagLink" href={`/archive?tag=${encodeURIComponent(tag)}`} data-astro-prefetch="hover">{tag}</a>
                    {index < post.tags.length - 1 ? <span>, </span> : null}
                  </>
                ))}
              </div>
            </footer>
          ) : null}
        </article>
      </section>
    </div>
  </SiteShell>
</BaseLayout>

<style>
  .releases-left {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .releases-left .block-releases-list {
    flex: 1;
    height: auto;
    margin: 0;
  }

  .releases-wide {
    height: 100%;
  }

  .releases-detail-box {
    position: relative;
    border: 1px solid #000;
    height: 100%;
    background: #fff;
    overflow-y: auto;
  }

  .detail-back {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 22px;
    line-height: 1;
  }

  .detail-back:hover {
    background: #fff;
  }

  .release-detail {
    display: grid;
    grid-template-columns: 420px 1fr;
    column-gap: 18px;
    align-items: start;
    padding: 16px;
  }

  .release-image {
    width: 420px;
    height: 420px;
    object-fit: cover;
    border: 1px solid #000;
    display: block;
  }

  .release-image-empty {
    background: transparent;
  }

  .release-meta {
    min-width: 320px;
    max-width: 720px;
    padding-right: 56px;
  }

  .release-date {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 1;
  }

  .release-title {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 400;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .release-credits {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 16px;
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .credit-label {
    font-family: "TT2020 Style B", "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: 0.2px;
  }

  .credit-value {
    font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }

  .release-body {
    margin: 0;
    font-size: 15.4px;
    line-height: 1.28;
  }

  .release-list-link {
    color: inherit;
    text-decoration: none;
  }

  .release-list-link:hover,
  .release-list-link.is-active {
    text-decoration: underline;
  }

  .post-tags {
    margin-top: 16px;
  }

  .post-tags .tagsText {
    display: inline-block;
    margin-top: 0;
    padding: 8px 10px;
    border: 1px solid #000;
    background: #fff;
  }

  .tagsLinks {
    display: block;
  }

  .tagLink {
    color: #000;
    text-decoration: none;
  }

  .tagLink:hover {
    text-decoration: underline;
  }
</style>