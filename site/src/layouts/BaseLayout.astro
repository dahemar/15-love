---
import "../styles/global.css";
import "../styles/responsive.css";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="dns-prefetch" href="https://strapi-client-15-love.onrender.com" />
    <link rel="preconnect" href="https://strapi-client-15-love.onrender.com" crossorigin />

    <link rel="preload" href="/fonts/Inter%20Regular-5af3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/15love_logo_1.svg" as="image" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
