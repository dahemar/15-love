---
import { getSiteContent } from "../../lib/siteContent";
import { getEventPostViews } from "../../lib/postViews";
import { clampText } from "../../lib/mobileExcerpt";
import MobilePostCard from "./MobilePostCard.astro";

const content = await getSiteContent();
const posts = getEventPostViews(content);

function eventExcerpt(post: (typeof posts)[number]): string {
  if (post.summary?.trim()) return clampText(post.summary);
  if (post.body?.trim()) return clampText(post.body);
  return "";
}
---

<section class="m-panel">
  <ul class="m-list">
    {posts.map((post, index) => {
      const image = post.image?.url ? { src: post.image.url, alt: post.image.alt } : null;
      const meta = [post.venue, post.dateLabel].filter(Boolean).join(" — ");
      return (
        <MobilePostCard
          href={post.href}
          title={post.title}
          image={image}
          meta={meta || undefined}
          excerpt={eventExcerpt(post)}
          eager={index < 2}
        />
      );
    })}
  </ul>
</section>
