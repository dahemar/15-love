---
import { newsImageDimensions } from "../../lib/newsImageWidth";
import { renderRichBody } from "../../lib/html";
import type { EventPostView } from "../../lib/postViews";
import MobileDetailTop from "./MobileDetailTop.astro";

type Props = {
  post: EventPostView;
};

const { post } = Astro.props;

function formatDateLabel(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(date);
}

const headerDate = post.dateLabel || formatDateLabel(post.publishedAt);
---

<article class="m-detail">
  <MobileDetailTop backHref="/events/" backLabel="Back to events" tags={post.tags} />
  <h1>{post.title}</h1>
  {headerDate ? <p class="m-post-date">{headerDate}</p> : null}
  {post.venue ? <p class="m-event-venue">{post.venue}</p> : null}

  {post.eventBlocks.map((block, index) => {
    if (block.__component === "events.details") return null;

    if (block.__component === "events.rich-text") {
      return <div class="m-event-body" set:html={renderRichBody(block.body)} />;
    }

    if (block.__component !== "events.media" || !block.image) return null;
    const size = block.imageWidth ?? "medium";
    const fallback = newsImageDimensions(size);

    return (
      <figure class="m-event-media">
        <img
          src={block.image.url}
          alt={block.image.alt}
          width={block.image.width ?? fallback.width}
          height={block.image.height ?? fallback.height}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 ? "high" : undefined}
        />
        {block.caption ? <figcaption>{block.caption}</figcaption> : null}
      </figure>
    );
  })}
</article>

<style>
  .m-post-date {
    margin: 0 0 10px;
    font-size: var(--m-type-meta);
    line-height: 1;
  }

  .m-event-venue {
    margin: 0 0 10px;
    font-family: "TT2020 Style B", "Inter", system-ui, sans-serif;
    font-size: var(--m-type-meta);
  }

  .m-event-media {
    margin: 0 0 12px;
  }

  .m-event-media img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #000;
  }

  .m-event-media figcaption {
    margin-top: 6px;
    font-size: var(--m-type-small);
    line-height: 1.25;
  }

  .m-event-body :global(p) {
    margin: 0 0 0.75em;
  }
</style>
