---
import { getSiteContent } from "../../lib/siteContent";

const content = await getSiteContent();
const entries = content.archiveEntries;
const tagOptions = Array.from(new Set(entries.flatMap((entry) => entry.tags))).sort((left, right) => left.localeCompare(right));
const dateOptions = Array.from(new Set(entries.map((entry) => entry.dateLabel).filter(Boolean)));
---

<section class="m-panel m-archive">
  <header class="m-archive-filters">
    <label>
      <span class="sr-only">Filter by type</span>
      <select class="m-filter" data-filter-kind="type">
        <option value="all">type</option>
        <option value="news">news</option>
        <option value="events">events</option>
        <option value="releases">releases</option>
      </select>
    </label>
    <label>
      <span class="sr-only">Filter by tag</span>
      <select class="m-filter" data-filter-kind="tag">
        <option value="all">tag</option>
        {tagOptions.map((tag) => (
          <option value={tag}>{tag}</option>
        ))}
      </select>
    </label>
    <label>
      <span class="sr-only">Filter by date</span>
      <select class="m-filter" data-filter-kind="date">
        <option value="all">date</option>
        {dateOptions.map((dateLabel) => (
          <option value={dateLabel}>{dateLabel}</option>
        ))}
      </select>
    </label>
  </header>

  <ul class="m-thumb-grid m-archive-grid">
    {entries.map((entry, index) => (
      <li
        class="m-thumb-cell m-archive-item"
        data-type={entry.category}
        data-tags={entry.tags.join("|")}
        data-date={entry.dateLabel}
      >
        <a href={entry.href} data-astro-prefetch="hover" title={entry.title}>
          {entry.thumbnail?.src ? (
            <img
              src={entry.thumbnail.src}
              alt={entry.thumbnail.alt}
              width="320"
              height="320"
              loading={index < 9 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index < 9 ? "high" : undefined}
            />
          ) : (
            <span class="m-thumb-empty" aria-hidden="true"></span>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>

<script is:inline>
  (() => {
    const filters = document.querySelectorAll(".m-archive .m-filter");
    const items = document.querySelectorAll(".m-archive-item");
    if (!filters.length || !items.length) return;

    const state = { type: "all", tag: "all", date: "all" };
    const readFilters = () => {
      filters.forEach((select) => {
        const kind = select.getAttribute("data-filter-kind");
        if (!kind || !(kind in state)) return;
        state[kind] = select.value;
      });
    };

    const apply = () => {
      items.forEach((item) => {
        let visible = true;
        if (state.type !== "all" && item.getAttribute("data-type") !== state.type) visible = false;
        if (state.tag !== "all") {
          const tags = (item.getAttribute("data-tags") || "").split("|");
          if (!tags.includes(state.tag)) visible = false;
        }
        if (state.date !== "all" && item.getAttribute("data-date") !== state.date) visible = false;
        item.style.display = visible ? "" : "none";
      });
    };

    filters.forEach((select) => {
      select.addEventListener("change", () => {
        readFilters();
        apply();
      });
    });
  })();
</script>

<style>
  .m-archive-filters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 10px;
    border-bottom: 1px solid #000;
  }

  .m-filter {
    width: 100%;
    border: 1px solid #000;
    background: #fff;
    font-family: inherit;
    font-size: 13px;
    min-height: 30px;
  }
</style>
