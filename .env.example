# local = static content in src/data/siteContent.ts (dev only)
# strapi = fetch from Strapi at build time (production / Vercel)
CMS_MODE=strapi

# Render instance (also set as default in src/lib/cmsConfig.ts for production builds)
STRAPI_URL=https://strapi-client-15-love.onrender.com

# Strapi → Settings → API Tokens (Read-only is enough)
# Required locally and in Vercel (not committed — add in Vercel → Settings → Environment Variables)
STRAPI_TOKEN=
