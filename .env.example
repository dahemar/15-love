# Copy to site/.env (Astro loads env from site/ via astro.config.mjs).
# All site content is fetched from Strapi on Render at build and dev time.

STRAPI_URL=https://strapi-client-15-love.onrender.com

# Strapi → Settings → API Tokens (Read-only is enough). Required for dev and Vercel builds.
STRAPI_TOKEN=
