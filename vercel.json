{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "env": {
    "STRAPI_URL": "https://strapi-client-15-love.onrender.com"
  },
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mobile/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.(?:ico|svg|webp|png|jpg|jpeg|woff2))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/m", "destination": "/", "permanent": false },
    { "source": "/m/", "destination": "/", "permanent": false },
    { "source": "/m/home", "destination": "/home", "permanent": false },
    { "source": "/m/home/", "destination": "/home/", "permanent": false },
    { "source": "/m/:path*", "destination": "/:path*", "permanent": false }
  ]
}
